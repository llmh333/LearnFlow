# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres (used by docker-compose.yml and backend datasource) ---
POSTGRES_DB=learnflow
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=learnflow
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Backend auth ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- AI provider (left empty until Phase 5) ---
ANTHROPIC_API_KEY=
